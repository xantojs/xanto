{
  "name": "@xanto/core",
  "version": "0.0.1",
  "description": "A modern backend framework for Node.js, Bun and Deno",
  "license": "MIT",
  "author": "Xanto.JS",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/server/routing/index.d.ts",
      "import": "./dist/server/routing/index.js",
      "default": "./dist/server/routing/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "default": "./dist/validation/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/deno": "^2.7.0",
    "@types/node": "^26.1.1",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "h3": "2.0.1-rc.29",
    "pathe": "2.0.3",
    "std-env": "4.2.0",
    "tinyglobby": "0.2.17",
    "valibot": "1.4.2"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2",
    "deno": ">=2.0"
  },
  "private": false,
  "keywords": [
    "framework",
    "backend",
    "typescript",
    "node",
    "bun",
    "deno"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xantojs/xanto.git"
  },
  "homepage": "https://github.com/xantojs/xanto",
  "bugs": {
    "url": "https://github.com/xantojs/xanto/issues"
  }
}
